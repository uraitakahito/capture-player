{
  // e2e の試験だけ。page.evaluate の中は Chrome で走るので DOM の型を足す。
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    // fixtures/derive-*.ts は node で直に走らせる（型を剥がして走るので、import は .ts のまま書く）。e2e は emit しない
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["**/*.ts", "../src/**/*"]
}
